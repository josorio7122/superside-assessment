---
interface Props {
	active: 'brands' | 'generations' | 'usage';
	path: string;
	title: string;
	subtitle?: string;
	breadcrumb?: { label: string; href?: string }[];
}
const { active, path, title, subtitle, breadcrumb } = Astro.props;

const nav = [
	{ id: 'brands', label: 'Brands', n: '7' },
	{ id: 'generations', label: 'Generations', n: '142' },
	{ id: 'usage', label: 'Usage', n: '$4.20' },
];
---

<div class="mockup-shell" role="img" aria-label={`Studio admin web mockup, ${title} screen`}>
	<div class="chrome">
		<div class="chrome-dots" aria-hidden="true">
			<span></span><span></span><span></span>
		</div>
		<div class="chrome-url">
			<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
				<rect x="2" y="4.5" width="6" height="4.5" rx="0.5" />
				<path d="M3.5 4.5 V3 a1.5 1.5 0 0 1 3 0 V4.5" />
			</svg>
			<span>studio.superside.app/{path}</span>
		</div>
		<div class="chrome-actions" aria-hidden="true">
			<span class="chrome-btn"></span>
			<span class="chrome-btn"></span>
		</div>
	</div>

	<div class="app" inert>
		<aside class="sidebar" aria-label="Studio navigation">
			<button type="button" class="sidebar-workspace" aria-label="Switch workspace">
				<span class="ws-mark" aria-hidden="true"></span>
				<span class="ws-text">
					<span class="ws-name">DesignTechCo</span>
					<span class="ws-meta mono">admin · pilot</span>
				</span>
				<svg class="ws-chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
					<path d="M3 4 L5 6 L7 4 M3 6.5 L5 8.5 L7 6.5" />
				</svg>
			</button>
			<nav>
				<ul>
					{nav.map((item) => (
						<li>
							<a
								href={`#solution-${item.id}`}
								data-active={item.id === active ? '' : null}
							>
								<span class="ico" aria-hidden="true">
									{item.id === 'brands' && (
										<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3">
											<rect x="2" y="2" width="4" height="4" /><rect x="8" y="2" width="4" height="4" /><rect x="2" y="8" width="4" height="4" /><rect x="8" y="8" width="4" height="4" />
										</svg>
									)}
									{item.id === 'generations' && (
										<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3">
											<circle cx="7" cy="7" r="5.2" /><path d="M7 4 V7 L9 8.5" />
										</svg>
									)}
									{item.id === 'usage' && (
										<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3">
											<path d="M2 11.5 L5 8 L7.5 10 L12 4" /><path d="M9 4 H12 V7" />
										</svg>
									)}
								</span>
								<span class="lbl">{item.label}</span>
								<span class="num">{item.n}</span>
							</a>
						</li>
					))}
				</ul>
			</nav>
			<div class="sidebar-footer">
				<div class="sidebar-user">
					<span class="user-avatar">J</span>
					<div>
						<p>Jo Osorio</p>
						<p class="mono">jo@designtech.co</p>
					</div>
				</div>
			</div>
		</aside>

		<main class="content">
			<header class="content-head">
				<div>
					{breadcrumb && (
						<nav class="breadcrumb mono" aria-label="Breadcrumb">
							{breadcrumb.map((b, i) => (
								<>
									{i > 0 && <span class="bc-sep" aria-hidden="true">/</span>}
									{b.href ? <a href={b.href}>{b.label}</a> : <span>{b.label}</span>}
								</>
							))}
						</nav>
					)}
					<h3>{title}</h3>
					{subtitle && <p>{subtitle}</p>}
				</div>
				<slot name="head-actions" />
			</header>
			<div class="content-body">
				<slot />
			</div>
		</main>
	</div>
</div>

<style>
	.mockup-shell {
		display: flex;
		flex-direction: column;
		background: oklch(99% 0.003 60);
		border-radius: 14px;
		overflow: hidden;
		box-shadow: var(--shadow-mockup);
		border: 1px solid oklch(85% 0.005 50);
		transition: box-shadow 240ms var(--ease-out-quart);
		font-family: var(--font-sans);
		color: var(--color-charcoal);
		width: 100%;
		min-height: 460px;
	}
	.mockup-shell:hover { box-shadow: var(--shadow-mockup-hover); }

	.chrome {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.55rem 0.85rem;
		background: oklch(95% 0.005 60);
		border-bottom: 1px solid var(--color-hairline);
	}
	.chrome-dots { display: flex; gap: 6px; }
	.chrome-dots span {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: oklch(85% 0.005 50);
	}
	.chrome-dots span:first-child { background: oklch(72% 0.13 25); }
	.chrome-dots span:nth-child(2) { background: oklch(82% 0.12 80); }
	.chrome-dots span:nth-child(3) { background: oklch(74% 0.13 145); }

	.chrome-url {
		flex: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		background: oklch(99% 0.003 60);
		border-radius: 6px;
		color: var(--color-stone);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.01em;
	}
	.chrome-actions { display: flex; gap: 4px; }
	.chrome-btn {
		width: 14px;
		height: 14px;
		border-radius: 3px;
		background: oklch(88% 0.005 50);
	}

	.app {
		display: grid;
		grid-template-columns: 200px 1fr;
		flex: 1;
		min-height: 0;
	}

	.sidebar {
		background: oklch(96.5% 0.005 60);
		border-right: 1px solid var(--color-hairline);
		padding: 1rem 0.85rem;
		display: flex;
		flex-direction: column;
		font-size: 0.8125rem;
	}
	.sidebar-workspace {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.55rem;
		margin-bottom: 0.85rem;
		background: oklch(99% 0.003 60);
		border: 1px solid var(--color-hairline);
		border-radius: 5px;
		cursor: pointer;
		text-align: left;
		font-family: var(--font-sans);
	}
	.ws-mark {
		width: 22px;
		height: 22px;
		border-radius: 4px;
		background: linear-gradient(135deg, oklch(64% 0.16 35) 0%, oklch(50% 0.16 25) 100%);
		flex-shrink: 0;
	}
	.ws-text { display: flex; flex-direction: column; min-width: 0; }
	.ws-name {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--color-charcoal);
		line-height: 1.2;
	}
	.ws-meta {
		font-size: 0.5625rem;
		color: var(--color-stone);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin-top: 0.1rem;
	}
	.ws-chevron { color: var(--color-stone); flex-shrink: 0; }

	.sidebar nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.sidebar nav a {
		display: grid;
		grid-template-columns: 18px 1fr auto;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0.6rem;
		border-radius: 5px;
		text-decoration: none;
		color: var(--color-reading);
		transition: background 160ms var(--ease-out-quart), color 160ms var(--ease-out-quart);
	}
	.sidebar nav a:hover { background: oklch(94% 0.006 60); color: var(--color-charcoal); }
	.sidebar nav a[data-active] {
		background: oklch(99% 0.003 60);
		color: var(--color-charcoal);
		box-shadow: inset 0 0 0 1px var(--color-hairline);
	}
	.sidebar nav .ico { color: var(--color-stone); }
	.sidebar nav a[data-active] .ico { color: var(--color-coral); }
	.sidebar nav .num {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-stone);
	}

	.sidebar-footer {
		margin-top: auto;
		padding: 0.85rem 0.6rem 0.3rem;
		border-top: 1px solid var(--color-hairline);
	}
	.sidebar-user {
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}
	.user-avatar {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: oklch(85% 0.06 35);
		color: oklch(25% 0.05 35);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.6875rem;
		font-weight: 500;
		flex-shrink: 0;
	}
	.sidebar-user div p {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.25;
	}
	.sidebar-user div p:first-child { color: var(--color-charcoal); font-weight: 500; }
	.sidebar-user div p:last-child {
		color: var(--color-stone);
		font-size: 0.625rem;
		letter-spacing: 0.02em;
	}

	.content {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.content-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		padding: 1.25rem 1.5rem 0.85rem;
		border-bottom: 1px solid var(--color-hairline);
	}
	.content-head h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--color-charcoal);
	}
	.content-head p {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		color: var(--color-stone);
		font-family: var(--font-mono);
		letter-spacing: 0.02em;
	}
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-stone);
		margin-bottom: 0.4rem;
	}
	.breadcrumb a {
		color: var(--color-stone);
		text-decoration: none;
		transition: color 160ms var(--ease-out-quart);
	}
	.breadcrumb a:hover { color: var(--color-charcoal); }
	.breadcrumb .bc-sep { opacity: 0.5; }
	.content-body {
		flex: 1;
		padding: 1.1rem 1.5rem 1.5rem;
		overflow: hidden;
	}

	@media (max-width: 720px) {
		.app { grid-template-columns: 1fr; }
		.sidebar {
			border-right: none;
			border-bottom: 1px solid var(--color-hairline);
			flex-direction: row;
			padding: 0.6rem 0.85rem;
			align-items: center;
			gap: 0.85rem;
			overflow-x: auto;
		}
		.sidebar-workspace { padding: 0.3rem 0.5rem; margin-bottom: 0; }
		.ws-meta { display: none; }
		.sidebar nav ul { flex-direction: row; }
		.sidebar nav a { padding: 0.3rem 0.5rem; }
		.sidebar nav .num { display: none; }
		.sidebar-footer { display: none; }
	}
</style>
