---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div class="footer-mark">
			<span class="footer-glyph serif">S</span>
			<span class="footer-name serif">tudio</span>
		</div>

		<div class="footer-meta">
			<p>
				Architecture-case deliverable. Jose Osorio, May {year}. Submitted to Superside.
			</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-hairline);
		padding: 2.5rem clamp(1rem, 4vw, 2.5rem) 2.5rem;
		margin-top: 4rem;
	}
	.footer-inner {
		max-width: 1320px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 2.5rem;
		align-items: center;
	}
	.footer-mark {
		display: inline-flex;
		align-items: baseline;
		font-size: 1.25rem;
		color: var(--color-charcoal);
		letter-spacing: -0.02em;
	}
	.footer-glyph {
		color: var(--color-coral);
		font-style: italic;
		font-weight: 600;
	}

	.footer-meta {
		max-width: 60ch;
		justify-self: end;
	}
	.footer-meta p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--color-reading);
	}

	@media (max-width: 720px) {
		.footer-inner { grid-template-columns: 1fr; gap: 1rem; }
		.footer-meta { justify-self: start; }
	}
</style>
