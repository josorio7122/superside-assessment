    {"type":"text","id":"f11_pod1_t","x":160,"y":11280,"width":240,"height":140,"text":"Worker pod 1\n\nconcurrency: 4\nlimiter: { max: 50, duration: 60_000 }\nremoveOnComplete: 1000\nstalledInterval: 30_000","originalText":"Worker pod 1\n\nconcurrency: 4\nlimiter: { max: 50, duration: 60_000 }\nremoveOnComplete: 1000\nstalledInterval: 30_000","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":11009,"version":1,"versionNonce":11010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"f11_pod1","lineHeight":1.5},
