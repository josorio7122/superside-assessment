    {"type":"text","id":"f05_l_rollback","x":1200,"y":4830,"width":140,"height":18,"text":"rollback (flag flip)","originalText":"rollback (flag flip)","fontSize":11,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#c25729","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":5049,"version":1,"versionNonce":5050,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"f05_caption","x":120,"y":5000,"width":1300,"height":140,"text":"One canonical brand_profile per brand. Only one row has is_current=true; that row grounds every prompt the platform sends to a model. Publishing flips the bit; rollback flips it back. Eval suite (Beta+) runs against drafts and can block the publish flip. Architecture rejects RAG: single canonical profile + fixed JSON schema + deterministic prompt construction is more reliable than retrieval over freeform docs for this scale (≤25 brands per tenant).","originalText":"One canonical brand_profile per brand. Only one row has is_current=true; that row grounds every prompt the platform sends to a model. Publishing flips the bit; rollback flips it back. Eval suite (Beta+) runs against drafts and can block the publish flip. Architecture rejects RAG: single canonical profile + fixed JSON schema + deterministic prompt construction is more reliable than retrieval over freeform docs for this scale (≤25 brands per tenant).","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4a4642","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":5051,"version":1,"versionNonce":5052,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

