    {"type":"arrow","id":"f15_eC","x":840,"y":15800,"width":370,"height":80,"strokeColor":"#c25729","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15027,"version":1,"versionNonce":15028,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"points":[[0,0],[370,80]],"startBinding":{"elementId":"f15_audit","focus":0,"gap":4},"endBinding":{"elementId":"f15_b3","focus":0,"gap":4},"startArrowhead":null,"endArrowhead":"arrow"},
    {"type":"text","id":"f15_caption","x":120,"y":16140,"width":1300,"height":140,"text":"Architecture stays neutral on the rollup question until Beta volume tells us which branch to commit to. The 2-week buffer to the 10-week ceiling exists for branch C — migrating during Final Rollout if Beta numbers demand it. Branch A is the most likely outcome at MVP-pilot scale (10 users → low volume); branch B kicks in around customer #5–10; branch C only if usage explodes or product expands into customer-facing analytics. PostHog already gives us managed columnar storage for telemetry regardless of branch.","originalText":"Architecture stays neutral on the rollup question until Beta volume tells us which branch to commit to. The 2-week buffer to the 10-week ceiling exists for branch C — migrating during Final Rollout if Beta numbers demand it. Branch A is the most likely outcome at MVP-pilot scale (10 users → low volume); branch B kicks in around customer #5–10; branch C only if usage explodes or product expands into customer-facing analytics. PostHog already gives us managed columnar storage for telemetry regardless of branch.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4a4642","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15029,"version":1,"versionNonce":15030,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5}
  ]
