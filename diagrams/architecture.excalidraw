    {"type":"text","id":"f14_caption","x":120,"y":14960,"width":1300,"height":140,"text":"Coral table = tenant root. Teal table = audit log of every generation (input + output kept for support + governance). Ochre table = atomic billing rows. Dashed table = optional rollup tier (see frame 15). Every non-root row carries org_id; every query layer scopes by request-context org_id; partial-unique indexes act as a backstop. brand_profile.is_current=true is enforced unique per brand_id via a partial index — only one current profile at a time.","originalText":"Coral table = tenant root. Teal table = audit log of every generation (input + output kept for support + governance). Ochre table = atomic billing rows. Dashed table = optional rollup tier (see frame 15). Every non-root row carries org_id; every query layer scopes by request-context org_id; partial-unique indexes act as a backstop. brand_profile.is_current=true is enforced unique per brand_id via a partial index — only one current profile at a time.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4a4642","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":14053,"version":1,"versionNonce":14054,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"text","id":"f15_title","x":120,"y":15540,"width":1100,"height":34,"text":"15  ·  Analytics scaling decision  (week-6 audit gate)","originalText":"15  ·  Analytics scaling decision  (week-6 audit gate)","fontSize":28,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15001,"version":1,"versionNonce":15002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"f15_eyebrow","x":120,"y":15580,"width":1200,"height":20,"text":"threshold-driven · gated on Beta metrics · Postgres direct  ·  daily rollups  ·  ClickHouse migration","originalText":"threshold-driven · gated on Beta metrics · Postgres direct  ·  daily rollups  ·  ClickHouse migration","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7e7a74","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15003,"version":1,"versionNonce":15004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
