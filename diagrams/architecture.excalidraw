    {"type":"text","id":"f09_r1","x":140,"y":9100,"width":1280,"height":24,"text":"Runtime           Node + TypeScript            Python · Go · Bun                    One language across plugin + API + worker + admin · shared Zod schemas · AI-SDK first-class","originalText":"Runtime           Node + TypeScript            Python · Go · Bun                    One language across plugin + API + worker + admin · shared Zod schemas · AI-SDK first-class","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9017,"version":1,"versionNonce":9018,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r2","x":140,"y":9132,"width":1280,"height":24,"text":"API framework     Hono                         Fastify · Express · NestJS · tRPC    Tiny · fast · edge-portable · native TS · no decorator/DI tax","originalText":"API framework     Hono                         Fastify · Express · NestJS · tRPC    Tiny · fast · edge-portable · native TS · no decorator/DI tax","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9019,"version":1,"versionNonce":9020,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r3","x":140,"y":9164,"width":1280,"height":24,"text":"ORM               Drizzle                      Prisma · raw SQL · Kysely            Type-safe SQL builder · no codegen · easy raw escape hatch · sub-ms cold start","originalText":"ORM               Drizzle                      Prisma · raw SQL · Kysely            Type-safe SQL builder · no codegen · easy raw escape hatch · sub-ms cold start","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9021,"version":1,"versionNonce":9022,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r4","x":140,"y":9196,"width":1280,"height":24,"text":"Queue             BullMQ + Redis               SQS · Kafka · Inngest · Trigger.dev  Self-hostable · pub/sub fan-out for SSE · low latency · mature retry semantics","originalText":"Queue             BullMQ + Redis               SQS · Kafka · Inngest · Trigger.dev  Self-hostable · pub/sub fan-out for SSE · low latency · mature retry semantics","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9023,"version":1,"versionNonce":9024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r5","x":140,"y":9228,"width":1280,"height":24,"text":"Realtime          SSE                          WebSockets · long-poll              Server-push enough · works through HTTP/2 · simpler than WS lifecycle · no client lib","originalText":"Realtime          SSE                          WebSockets · long-poll              Server-push enough · works through HTTP/2 · simpler than WS lifecycle · no client lib","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9025,"version":1,"versionNonce":9026,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r6","x":140,"y":9260,"width":1280,"height":24,"text":"Auth              WorkOS                       Auth0 · Clerk · build-it-yourself    Sealed sessions + Roles + User Management widget · zero custom auth code · SOC2-ready","originalText":"Auth              WorkOS                       Auth0 · Clerk · build-it-yourself    Sealed sessions + Roles + User Management widget · zero custom auth code · SOC2-ready","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9027,"version":1,"versionNonce":9028,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r7","x":140,"y":9292,"width":1280,"height":24,"text":"Models            OpenRouter (text) + OpenAI (image)  Bedrock · direct OpenAI for text       Single text gateway from MVP · Beta adds fal.ai for image-to-image + image fallback","originalText":"Models            OpenRouter (text) + OpenAI (image)  Bedrock · direct OpenAI for text       Single text gateway from MVP · Beta adds fal.ai for image-to-image + image fallback","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#c25729","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9029,"version":1,"versionNonce":9030,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r8","x":140,"y":9324,"width":1280,"height":24,"text":"Observability     PostHog (single platform)    Sentry + Datadog + LangSmith stack   One vendor · 7 capabilities · one query language · fits 2-engineer team","originalText":"Observability     PostHog (single platform)    Sentry + Datadog + LangSmith stack   One vendor · 7 capabilities · one query language · fits 2-engineer team","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#c25729","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9031,"version":1,"versionNonce":9032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r9","x":140,"y":9356,"width":1280,"height":24,"text":"Analytics scaling Postgres → audit at week 6   ClickHouse pre-commit                Threshold-driven · skip / rollups / migrate based on Beta volume · see frame 15","originalText":"Analytics scaling Postgres → audit at week 6   ClickHouse pre-commit                Threshold-driven · skip / rollups / migrate based on Beta volume · see frame 15","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9033,"version":1,"versionNonce":9034,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_r10","x":140,"y":9388,"width":1280,"height":24,"text":"Storage           S3 + Postgres + Redis        RDS-only · Supabase · R2 · GCS       Cheap · well-trodden · easy local-dev parity · LocalStack covers S3 in dev","originalText":"Storage           S3 + Postgres + Redis        RDS-only · Supabase · R2 · GCS       Cheap · well-trodden · easy local-dev parity · LocalStack covers S3 in dev","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9035,"version":1,"versionNonce":9036,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.4},
    {"type":"text","id":"f09_caption","x":120,"y":9540,"width":1300,"height":140,"text":"Coral rows are the picks that change between MVP and Beta. Every other pick is fixed at MVP and stays. Picks favour managed services over operating infra (WorkOS, PostHog, S3, OpenAI) and one-language stack across surfaces. Frames 10–13 go deeper on the picks that carry the most weight: Node + TS, worker concurrency, LLM proxy routing, observability stack.","originalText":"Coral rows are the picks that change between MVP and Beta. Every other pick is fixed at MVP and stays. Picks favour managed services over operating infra (WorkOS, PostHog, S3, OpenAI) and one-language stack across surfaces. Frames 10–13 go deeper on the picks that carry the most weight: Node + TS, worker concurrency, LLM proxy routing, observability stack.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#4a4642","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":9037,"version":1,"versionNonce":9038,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

