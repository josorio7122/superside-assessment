    {"type":"text","id":"f11_eyebrow","x":120,"y":11180,"width":1200,"height":20,"text":"BullMQ knobs · OpenAI-bound work · concurrency = rate limit · stateless workers · queue-depth autoscale at Final Rollout","originalText":"BullMQ knobs · OpenAI-bound work · concurrency = rate limit · stateless workers · queue-depth autoscale at Final Rollout","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#7e7a74","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":11003,"version":1,"versionNonce":11004,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
