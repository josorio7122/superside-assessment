    {"type":"text","id":"f10_a1","x":140,"y":10210,"width":1280,"height":48,"text":"One language across plugin + API + worker + admin\n   ✓  yes (plugin runtime is JS-only)               ✗  separate plugin codebase                ✗  separate plugin codebase","originalText":"One language across plugin + API + worker + admin\n   ✓  yes (plugin runtime is JS-only)               ✗  separate plugin codebase                ✗  separate plugin codebase","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10017,"version":1,"versionNonce":10018,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},
    {"type":"text","id":"f10_a2","x":140,"y":10270,"width":1280,"height":48,"text":"Shared types end-to-end (plugin → API → worker)\n   ✓  Zod everywhere                                ✗  Pydantic separate                       ✗  structs separate","originalText":"Shared types end-to-end (plugin → API → worker)\n   ✓  Zod everywhere                                ✗  Pydantic separate                       ✗  structs separate","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10019,"version":1,"versionNonce":10020,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},
    {"type":"text","id":"f10_a3","x":140,"y":10330,"width":1280,"height":48,"text":"Vercel AI SDK + multi-provider client maturity\n   ✓  first-class                                   ✓  mature (LangChain etc.)                 ~  thin SDK ecosystem","originalText":"Vercel AI SDK + multi-provider client maturity\n   ✓  first-class                                   ✓  mature (LangChain etc.)                 ~  thin SDK ecosystem","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10021,"version":1,"versionNonce":10022,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},
    {"type":"text","id":"f10_a4","x":140,"y":10390,"width":1280,"height":48,"text":"Concurrency model under our load (peak ~3 writes/sec)\n   ~  single-thread + libuv async (fine)            ~  GIL or asyncio (fine)                   ✓  goroutines (best, but unused at our scale)","originalText":"Concurrency model under our load (peak ~3 writes/sec)\n   ~  single-thread + libuv async (fine)            ~  GIL or asyncio (fine)                   ✓  goroutines (best, but unused at our scale)","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10023,"version":1,"versionNonce":10024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},
    {"type":"text","id":"f10_a5","x":140,"y":10450,"width":1280,"height":48,"text":"AI agent–assisted code-gen quality (training-data depth)\n   ✓  strongest                                     ✓  strong                                  ~  weaker for ORM/web layer","originalText":"AI agent–assisted code-gen quality (training-data depth)\n   ✓  strongest                                     ✓  strong                                  ~  weaker for ORM/web layer","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10025,"version":1,"versionNonce":10026,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},
    {"type":"rectangle","id":"f10_verdict","x":140,"y":10550,"width":1280,"height":100,"strokeColor":"#c25729","backgroundColor":"#f7d6c5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10027,"version":1,"versionNonce":10028,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"f10_verdict_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"f10_verdict_t","x":160,"y":10570,"width":1240,"height":60,"text":"Verdict.  Plugin runtime is JS-only — that constraint alone makes Node + TS the cheapest path. Same Zod schemas across plugin / API / worker / admin. Same agents code-gen everywhere. Concurrency tradeoff against Go matters at high CPU contention; image gen is OpenAI-bound, not CPU-bound, so we never hit it.","originalText":"Verdict.  Plugin runtime is JS-only — that constraint alone makes Node + TS the cheapest path. Same Zod schemas across plugin / API / worker / admin. Same agents code-gen everywhere. Concurrency tradeoff against Go matters at high CPU contention; image gen is OpenAI-bound, not CPU-bound, so we never hit it.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10029,"version":1,"versionNonce":10030,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"f10_verdict","lineHeight":1.5},

