    {"type":"text","id":"f15_audit_t","x":620,"y":15700,"width":300,"height":60,"text":"Week 6 audit\nvolume + p95 + growth rate","originalText":"Week 6 audit\nvolume + p95 + growth rate","fontSize":13,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15009,"version":1,"versionNonce":15010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"f15_audit","lineHeight":1.25},
    {"type":"rectangle","id":"f15_b1","x":140,"y":15880,"width":380,"height":210,"strokeColor":"#5a8c7a","backgroundColor":"#d6e7df","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15011,"version":1,"versionNonce":15012,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"f15_b1_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"f15_b1_t","x":160,"y":15900,"width":340,"height":170,"text":"Branch A · Skip rollups\n\nIf:  vol < 50k events/day\n     p95 < 200ms on raw queries\n\nShip:  direct Postgres queries continue\n        index review only\n\nRevisit:  month 3 post-launch","originalText":"Branch A · Skip rollups\n\nIf:  vol < 50k events/day\n     p95 < 200ms on raw queries\n\nShip:  direct Postgres queries continue\n        index review only\n\nRevisit:  month 3 post-launch","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15013,"version":1,"versionNonce":15014,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"f15_b1","lineHeight":1.5},
    {"type":"rectangle","id":"f15_b2","x":580,"y":15880,"width":380,"height":210,"strokeColor":"#b8893a","backgroundColor":"#ecdab4","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15015,"version":1,"versionNonce":15016,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"f15_b2_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"f15_b2_t","x":600,"y":15900,"width":340,"height":170,"text":"Branch B · Build daily aggregates\n\nIf:  vol 50k–500k/day\n     p95 200ms–1s on raw\n\nShip:  daily aggregate table per\n        (org, user, brand, feature, date)\n        nightly refresh\n        dashboard reads aggregates\n        drill-down to raw usage_event\n\nimplementation TBD when audit picks","originalText":"Branch B · Build daily aggregates\n\nIf:  vol 50k–500k/day\n     p95 200ms–1s on raw\n\nShip:  daily aggregate table per\n        (org, user, brand, feature, date)\n        nightly refresh\n        dashboard reads aggregates\n        drill-down to raw usage_event\n\nimplementation TBD when audit picks","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15017,"version":1,"versionNonce":15018,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"f15_b2","lineHeight":1.5},
    {"type":"rectangle","id":"f15_b3","x":1020,"y":15880,"width":380,"height":210,"strokeColor":"#c25729","backgroundColor":"#f7d6c5","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15019,"version":1,"versionNonce":15020,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"f15_b3_t","type":"text"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"f15_b3_t","x":1040,"y":15900,"width":340,"height":170,"text":"Branch C · Migrate to ClickHouse\n\nIf:  vol > 500k/day sustained, OR\n     p95 > 1s on rollups, OR\n     customer-facing analytics in scope\n\nShip:  usage_event mirror via PostHog batch export or CDC\n        Postgres stays OLTP source of truth","originalText":"Branch C · Migrate to ClickHouse\n\nIf:  vol > 500k/day sustained, OR\n     p95 > 1s on rollups, OR\n     customer-facing analytics in scope\n\nShip:  usage_event mirror via PostHog batch export or CDC\n        Postgres stays OLTP source of truth","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#2a2622","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":15021,"version":1,"versionNonce":15022,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"f15_b3","lineHeight":1.5},
